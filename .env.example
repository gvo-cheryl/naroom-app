# Public API endpoint for Expo development
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional: public Sentry DSN
EXPO_PUBLIC_SENTRY_DSN=

# Admin Web preview iframe이 postMessage로 preview token을 보낼 때 허용할 origin. 비워두면
# origin 검사를 생략한다(로컬 개발 편의) - 실제 배포 환경에서는 반드시 admin origin을 채운다.
EXPO_PUBLIC_ADMIN_ORIGIN=

# Kakao Developers 콘솔에서 발급받은 Native App Key (앱 번들에 포함되는 값, EXPO_PUBLIC_ 접두사 아님 —
# 빌드 시점에 app.config.js가 네이티브 설정(Info.plist/AndroidManifest)에 주입한다)
KAKAO_NATIVE_APP_KEY=

# Google Cloud Console iOS OAuth Client ID를 "com.googleusercontent.apps.<client-id>" 형태로
# 뒤집은 값 (Firebase 미사용, 빌드 시점에 app.config.js가 iOS URL scheme으로 주입한다)
GOOGLE_IOS_URL_SCHEME=

# Google Cloud Console에서 발급받은 Web/iOS OAuth Client ID. OAuth Client ID는 비밀값이 아니라
# 클라이언트 번들에 그대로 노출돼도 되므로 EXPO_PUBLIC_ 접두사를 쓴다.
# webClientId는 naroom-api GOOGLE_OAUTH_WEB_CLIENT_ID와 같은 값이어야 한다(서버가 이 값을 aud로 검증).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=